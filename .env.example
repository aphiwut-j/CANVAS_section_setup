# Use the HTTPS root of your institution's Canvas instance, without /api/v1.
CANVAS_BASE_URL=https://canvas.example.edu
# Configure this secret in the environment. Never commit it.
CANVAS_API_TOKEN=
# Set true only for local UI demonstration with generated sample data.
CANVAS_DEMO_MODE=false
APP_HOST=127.0.0.1
APP_PORT=8010
SECRET_KEY=replace-with-a-random-local-value

